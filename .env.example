#Este archivo se usa de ejemplo para el usuario ya que el .env original en github no se almacena

DB_URL=jdbc:postgresql://localhost:5432/tecnouam_prestamos
DB_USERNAME=postgres
DB_PASSWORD=cambie_esta_contrasena

# Mínimo 32 caracteres. Genere uno propio, por ejemplo con:  openssl rand -base64 48
JWT_SECRET=cambie_este_espacio_por_un_token_largo_y_aleatorio_min_32_chars
#Usar https://jwtsecretkeygenerator.com/ que ayuda a desarrollar el JWK
JWT_EXPIRATION_MS=3600000

CORS_ALLOWED_ORIGINS=http://localhost:5173
